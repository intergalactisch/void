# Loose screenshots in repo root (place under plans/ if intentional)
/*.png

# Internal planning docs — public roadmap lives at docs/ROADMAP.md
plans/

# Local AI CLI configuration (not part of the project)
.codex/
.agents/
.claude/

# IntelliJ IDEA project files (per-developer, not portable)
.idea/

# Other per-developer editor configs (analogous to .idea/)
.fleet/
.zed/
.cursor/

# Test-coverage HTML reports — generated by `npm run test:coverage`, not source
coverage/

# OS noise
Thumbs.db
desktop.ini

# Editor swap / backup files
*.swp
*.swo
*~

# Generic logs and temp files
*.log
*.tmp
